{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-events-jp-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "send_metrics": false,
  "vars": {
    "APP_ENV": "staging",
    "DEPLOYMENT_ENV": "staging",
    "DATABASE_ENVIRONMENT": "staging",
    "DATABASE_NAME": "astro-events-jp-staging",
    "REPORTS_REPOSITORY": "Raccoon26/Astro-Events-JP-Reports",
    "COLLECTION_ENABLED": "false",
    "NOTIFICATIONS_ENABLED": "false"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro-events-jp-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "astro-events-jp-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "DEPLOYMENT_ENV": "staging",
        "DATABASE_ENVIRONMENT": "staging",
        "DATABASE_NAME": "astro-events-jp-staging",
        "REPORTS_REPOSITORY": "Raccoon26/Astro-Events-JP-Reports",
        "COLLECTION_ENABLED": "false",
        "NOTIFICATIONS_ENABLED": "false"
      },
      "triggers": {
        "crons": ["0 */3 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "astro-events-jp-staging",
          "database_id": "14a756a0-4721-482a-9021-47d237be6f02",
          "migrations_dir": "migrations"
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    },
    "production": {
      "name": "astro-events-jp-production",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "DEPLOYMENT_ENV": "production",
        "DATABASE_ENVIRONMENT": "production",
        "DATABASE_NAME": "astro-events-jp-production",
        "REPORTS_REPOSITORY": "Raccoon26/Astro-Events-JP-Reports",
        "COLLECTION_ENABLED": "false",
        "NOTIFICATIONS_ENABLED": "false"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "astro-events-jp-production",
          "database_id": "497d64ba-c18f-404b-b1b5-1dd13676ed39",
          "migrations_dir": "migrations"
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    }
  },
  "account_id": "1514f5aa90cda572796a699965567bee"
}
