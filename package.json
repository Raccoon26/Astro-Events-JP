{
  "name": "astro-events-jp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "preinstall": "node scripts/preflight.mjs",
    "typecheck": "npm run types:check && tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "build": "node scripts/build.mjs && node scripts/build-collector.mjs && node scripts/build-verifier.mjs",
    "security": "node scripts/audit.mjs && npm audit --audit-level=high",
    "audit:requirements": "node scripts/coverage.mjs",
    "check": "node scripts/preflight.mjs && npm run check:cloudflare && npm run seed:validate && npm run typecheck && npm run lint && npm test && npm run build && npm run security && npm run audit:requirements && npm run d1:local",
    "seed:validate": "node scripts/registry.mjs validate",
    "seed:init": "node scripts/registry.mjs init",
    "seed:import": "node scripts/registry.mjs import",
    "registry:list": "node scripts/registry.mjs list",
    "registry:stats": "node scripts/registry.mjs stats",
    "registry:coverage": "node scripts/registry.mjs coverage",
    "collector:status": "node scripts/collector.mjs status",
    "collector:review": "node scripts/collector.mjs review",
    "collector:approve": "node scripts/collector.mjs approve",
    "collector:run": "node scripts/collector.mjs run-one",
    "cleanup": "node scripts/cleanup.mjs",
    "paths": "node scripts/preflight.mjs",
    "dev": "node scripts/wrangler.mjs dev --env staging --persist-to ../cache/wrangler-state/staging --test-scheduled",
    "d1:local": "node scripts/local-d1.mjs staging",
    "complete:dev": "node scripts/complete-dev.mjs",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "types:check": "node scripts/wrangler.mjs types src/worker-bindings.d.ts --env staging --env-interface WranglerBindings --strict-vars=false --include-runtime=false --include-main-module=false --check",
    "verifier:init": "node scripts/verifier.mjs init",
    "verifier:pending": "node scripts/verifier.mjs pending",
    "verifier:review": "node scripts/verifier.mjs review",
    "verifier:images": "node scripts/verifier.mjs images",
    "verifier:stats": "node scripts/verifier.mjs stats",
    "verifier:history": "node scripts/verifier.mjs history",
    "verifier:facility": "node scripts/verifier.mjs facility",
    "verifier:notice": "node scripts/verifier.mjs notice",
    "verifier:notices": "node scripts/verifier.mjs notices",
    "verifier:notice-history": "node scripts/verifier.mjs notice-history"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "22.20.5",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20261110.0-beta",
    "sql.js": "1.16.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "dependencies": {
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "saxes": "6.0.0"
  }
}
